{
  "name": "coverage-loop-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "Java + React local coverage workbench",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "npm run dev --workspace apps/desktop",
    "build:backend": "node scripts/backend.mjs package -DskipTests",
    "build": "npm run build:backend && npm run build --workspace apps/desktop",
    "test:backend": "node scripts/backend.mjs test",
    "test:desktop": "node --test apps/desktop/electron/*.test.cjs",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "package:win": "npm run build && node scripts/runtime.mjs && npm run package:win --workspace apps/desktop",
    "test:ui": "npm run test --workspace apps/desktop",
    "postinstall": "node scripts/sync-aceternity.mjs",
    "ui:sync": "node scripts/sync-aceternity.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "https-proxy-agent": "^7.0.6"
  }
}
